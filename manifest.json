{
  "schemaVersion": 1,
  "id": "io.github.advocu.solar-scope",
  "name": "Solar Scope",
  "version": "1.1.0",
  "author": "Suyash Verma",
  "description": "A live solar system in the bar: planets as dots on thin orbits, with playback and a hologram mode.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Solar Scope",
    "category": "Info",
    "defaultSection": "right",
    "allowMultiple": false,
    "defaults": {
      "showPluto": false,
      "showNames": true,
      "showRoadster": false
    },
    "schema": [
      {
        "key": "showPluto",
        "type": "boolean",
        "label": "Show Pluto (P)",
        "defaultValue": false
      },
      {
        "key": "showNames",
        "type": "boolean",
        "label": "Show planet names (Space or N)",
        "defaultValue": true
      },
      {
        "key": "showRoadster",
        "type": "boolean",
        "label": "Show the Tesla Roadster row (T)",
        "defaultValue": false
      }
    ],
    "description": "Tiny orbit icon; opens a scope of the solar system.",
    "aliases": [
      "solar",
      "planets",
      "orrery"
    ]
  },
  "license": "MIT"
}
